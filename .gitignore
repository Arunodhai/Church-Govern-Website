# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.playwright-cli/
/.playwright-mcp/
/output/
/.analysis/
/.sanity/

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# client source material (not for the public repository)
/docs/source/

# local Supabase CLI linkage and runtime metadata
/supabase/.temp/

# local agent tooling (not application source)
/.agent/
/.agents/
/.claude/
/.codex/
/.cursor/
/.gemini/
/.hermes/
/.impeccable/
/.kiro/
/.omc/
/.opencode/
/.pi/
/.qoder/
/.vibe/

# local visual-review captures and duplicate source artwork
/home-before-full.png
/home-hero-before.png
/main img.png

# typescript
*.tsbuildinfo
next-env.d.ts

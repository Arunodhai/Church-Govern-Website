# Public site configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
APP_ENV=development
# Development-only end-to-end demo. It supplies labelled editorial content and
# simulates public submissions/admin workflow without persisting or emailing.
# Production ignores this flag and requires approved live services.
USE_MOCK_CONTENT=true
# Local development defaults to simulated writes when this is absent. Set false
# in staging so mock editorial content can use real Supabase operations.
USE_MOCK_OPERATIONS=true

# Sanity CMS. Create the project/dataset in an SBL-owned Sanity organization.
# The read token is optional for a public dataset, but required for preview/live
# draft features. Keep all tokens server-only.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-08-19
SANITY_API_READ_TOKEN=
NEXT_PUBLIC_SANITY_STUDIO_URL=
# Staging-only end-to-end CMS demo. Never exposes provisional content in production.
SANITY_CONTENT_DEMO_MODE=false
# Sanity Studio is a standalone Vite build and only exposes this prefix.
# Keep these identifiers aligned with the matching NEXT_PUBLIC values above.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
SANITY_STUDIO_API_VERSION=2026-08-19

# Supabase browser-safe credentials
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase credential. Leave empty unless a reviewed server-only
# operation requires it; never reference this variable from a Client Component.
SUPABASE_SERVICE_ROLE_KEY=

# Optional analytics. Keep empty until the client-owned properties and consent
# behavior are approved.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_META_PIXEL_ID=

# Resend transactional lead notifications. Verify the sending domain first.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
LEAD_NOTIFICATION_EMAIL=

# Optional anti-abuse boundary for public forms.
RATE_LIMIT_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

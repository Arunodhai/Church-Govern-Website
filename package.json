    "@supabase/supabase-js": "^2.112.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.31.0",
    "next": "16.3.1",
    "next-sanity": "^13.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "resend": "^6.21.0",
    "sanity": "^6.10.1",
    "styled-components": "^6.5.3",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
